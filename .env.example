# local = in-memory + SQLite (no cloud creds needed); gcp = BigQuery + Firestore + Gemini on Vertex AI
REKINDLE_MODE=local
# dry_run logs messages to the outbox only; live calls WhatsApp Cloud API / Gmail API
REKINDLE_SEND_MODE=dry_run
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
BQ_DATASET=rekindle
# WhatsApp Cloud API (only for SEND_MODE=live)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me
# Gmail API sender (only for SEND_MODE=live); service account with domain-wide delegation
GMAIL_SENDER=
