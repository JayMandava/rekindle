# local = in-memory + SQLite + offline drafter (no credentials)
# spark = SQLite + Firestore + Gemini via API key (Firebase Spark plan, no billing)
# gcp   = BigQuery + Firestore + Gemini on Vertex AI (needs billing)
REKINDLE_MODE=local
GEMINI_API_KEY=
# a service-account key as JSON text (e.g. a secret); written to a private temp file at startup
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# dry_run logs messages to the outbox only; live calls WhatsApp Cloud API / Gmail API
REKINDLE_SEND_MODE=dry_run
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.8-flash
# Gemini 3.x is served from the global endpoint on Vertex AI (unverified for every project: check the model page)
GEMINI_LOCATION=global
GEMINI_THINKING_LEVEL=LOW
BQ_DATASET=rekindle
# WhatsApp Cloud API (only for SEND_MODE=live)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me
# Gmail API sender (only for SEND_MODE=live); service account with domain-wide delegation
GMAIL_SENDER=
